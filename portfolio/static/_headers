# Built files under /_app/immutable/ have a content hash in their names, so browsers can keep them for a year
# without checking back. Everything else keeps Cloudflare's default (revalidate on every visit).
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

# The plain-text copies for AI agents (see src/lib/server/agents.js) are ASCII, but say UTF-8 in case a
# character slips through.
/*.md
  Content-Type: text/markdown; charset=utf-8
/llms.txt
  Content-Type: text/plain; charset=utf-8
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
